{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/docs/skills-settings-rules.md",
    ".opencode/prompts/agent-knowledge-awareness.md"
  ],
  "permissions": [
    { "action": "playwright*", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "plugins": ["@dietrichgebert/ponytail"],
  "mcp": {
    "servers": {
      "playwright-test": {
        "type": "local",
        "command": ["npx", "playwright", "run-test-mcp-server"],
        "disabled": false
      },
      "codegraph": {
        "type": "local",
        "command": ["npx", "@colbymchenry/codegraph", "serve", "--mcp"],
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{file:.opencode/secrets/context7-api-key}"
        },
        "disabled": false
      }
    }
  },
  "default_agent": "orchestrator",
  "agents": {
    "orchestrator": {
      "description": "Main orchestrator. Brainstorms, maps architectural blueprints, and executes the sequential development and testing pipeline.",
      "mode": "primary",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "frontend-dev": {
      "description": "Consolidated developer sub-agent. Builds cohesive features writing HTML structures, modular styles, and JS interaction in tandem.",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "code-review": {
      "description": "Strict compliance auditor. Verifies generated code against the requested specifications and skills checklists.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    },
    "release-manager": {
      "description": "Release coordinator. Creates release branches, runs pre-release checks, merges to main, tags versions.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    },
    "playwright-test-planner": {
      "description": "Use this agent to create a comprehensive test plan markdown by exploring the web interface.",
      "mode": "subagent",
      "system": "{file:.opencode/prompts/playwright-test-planner.md}",
      "permissions": [
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*browser_*", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*planner_*", "resource": "*", "effect": "allow" }
      ]
    },
    "playwright-test-generator": {
      "description": "Use this agent to automatically generate real Playwright TypeScript source code files from written test plans.",
      "mode": "subagent",
      "system": "{file:.opencode/prompts/playwright-test-generator.md}",
      "permissions": [
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*browser_*", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*generator_*", "resource": "*", "effect": "allow" }
      ]
    },
    "playwright-test-healer": {
      "description": "Use this agent to run, debug, and auto-heal/fix failing Playwright tests dynamically.",
      "mode": "subagent",
      "system": "{file:.opencode/prompts/playwright-test-healer.md}",
      "permissions": [
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*browser_*", "resource": "*", "effect": "allow" },
        { "action": "playwright-test*test_*", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
